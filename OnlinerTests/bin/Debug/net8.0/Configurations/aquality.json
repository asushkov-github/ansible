{
  "driverSettings": {
    "browserName": "chrome",
    "isRemote": false,
    "capabilities": {
      "browserName": "chrome",
      "goog:chromeOptions": {
        "args": ["--headless=new", "--no-sandbox", "--disable-dev-shm-usage", "--window-size=1366,900"]
      }
    }
  },
  "timeouts": {
    "script": 15000,
    "implicit": 0,
    "pageLoad": 60000
  },
  "logger": {"logLevel": "info"},
  "projectName": "Onliner.by UI",
  "environment": "local"
}